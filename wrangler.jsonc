{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechat-trip-vote",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "VOTE_KV"
    }
  ],
  "observability": {
    "enabled": true
  }
}
